# Copy to backend/.env and edit. Every value is optional — the app runs without
# this file at all, using SQLite and username/password accounts.

# Signs session tokens. Change this before exposing the app beyond your network.
SECRET_KEY=change-me-to-a-long-random-string

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Add every origin you open the app from as an Authorised JavaScript origin,
# including your phone's LAN URL. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# Swap SQLite for Postgres if you want to.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ipl_auction

# Auction pacing
# BID_TIMER_SECONDS=15
# BID_RESET_SECONDS=15
# MAX_LOT_SECONDS=180
